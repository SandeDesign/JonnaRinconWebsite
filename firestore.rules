rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Beats collection - public read, admin write
    match /beats/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tracks collection - authenticated read, admin write
    match /tracks/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Remixes collection - authenticated read, admin write
    match /remixes/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Edits collection - authenticated read, admin write
    match /edits/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || isAdmin());
      allow write: if isAdmin();
    }

    // Content collection
    match /content/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Collaborations collection - admin only
    match /collaborations/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Collaboration messages
    match /collaborations/{collabId}/messages/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Settings collection - admin only
    match /settings/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Analytics collection - admin only
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Newsletter subscribers
    match /newsletter_subscribers/{document=**} {
      allow write: if true;
      allow read: if isAdmin();
    }
  }
}
